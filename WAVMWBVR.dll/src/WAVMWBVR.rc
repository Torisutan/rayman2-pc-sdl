LANGUAGE 0x0C, 0x01

1 VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x1L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "UBI SOUND STUDIO"
            VALUE "FileDescription", "ACP-SND Dll"
            VALUE "FileVersion", "Moteur sonore ACP - Version M5.8.4"
            VALUE "InternalName", "None"
            VALUE "LegalCopyright", "Copyright \251 1998"
            VALUE "OriginalFilename", "None"
            VALUE "ProductName", "UBI ACP-SND"
            VALUE "ProductVersion", "1, 0, 0, 1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 1200
    END
END
